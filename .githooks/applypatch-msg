#
# applypatch-msg — the same check, for `git am`.
#
# commit-msg does not run when a commit arrives as a mailed patch, which
# is exactly how a co-author trailer written elsewhere gets into a history
# that has a commit-msg hook. This closes that door.

set -uo pipefail
exec "$(git rev-parse --show-toplevel)/tools/check-attribution.sh" --message "$1"
