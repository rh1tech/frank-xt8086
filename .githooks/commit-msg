# commit-msg — refuse a commit whose message or identity credits an AI.
#
# The first of several gates and not the strongest: it only protects a
# clone that has opted in with `make hooks`, and it never runs for a
# commit authored through GitHub's web surface. CI is what enforces the
# policy for everyone; see .github/workflows/ci.yml.
#
# Bypass, if you genuinely must:  git commit --no-verify
# (pre-push will still catch it before it leaves the machine.)

set -uo pipefail
exec "$(git rev-parse --show-toplevel)/tools/check-attribution.sh" --message "$1"
